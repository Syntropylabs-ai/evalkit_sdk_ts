{
  "name": "syntropylabs-evalkit",
  "version": "0.2.17",
  "description": "EvalKit TypeScript SDK \u2014 OpenTelemetry-based LLM observability and tracing",
  "license": "Apache-2.0",
  "author": "Syntropy Labs",
  "homepage": "https://syntropylabs.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntropylabs-ai/evalkit_sdk_ts.git"
  },
  "bugs": {
    "url": "https://github.com/Syntropylabs-ai/evalkit_sdk_ts/issues"
  },
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "evaluation",
    "opentelemetry",
    "otel",
    "openai",
    "anthropic",
    "ai",
    "agents"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format cjs,esm --dts --clean --minify --treeshake --no-sourcemap --external syntropylabs-evalkit",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/autotrace.e2e.mjs && node test/host-otel.e2e.mjs && node test/explicit-provider.e2e.mjs && node test/redaction.e2e.mjs && node test/streaming-ttft.e2e.mjs && node test/stream-failure.e2e.mjs && node test/google-genai-thinking.e2e.mjs && node test/stream-usage-warning.e2e.mjs && node test/attr-spellings.e2e.mjs && node test/foreign-llm-counted.e2e.mjs && node tests/smoke.cjs && node test/feedback.e2e.mjs && node test/eval.e2e.mjs && node test/eval-cli.e2e.mjs && node test/identity.e2e.mjs && node test/coding-cli.e2e.mjs && node test/coding-spans.e2e.mjs && node test/coding-cli-parity.e2e.mjs && node test/prompts.e2e.mjs && node test/secrets.e2e.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "openai": ">=4.0.0",
    "@aws-sdk/client-bedrock-runtime": "*",
    "@aws-sdk/client-bedrock-agent-runtime": "*",
    "cohere-ai": "*",
    "@google/generative-ai": "*",
    "@google/genai": "*",
    "@google-cloud/vertexai": "*",
    "@langchain/core": "*",
    "groq-sdk": "*",
    "pg": "*",
    "mysql2": "*",
    "mongoose": "*",
    "ioredis": "*",
    "ollama": "*",
    "@pinecone-database/pinecone": "*",
    "@qdrant/js-client-rest": "*",
    "chromadb": "*",
    "weaviate-client": "*",
    "llamaindex": "*",
    "@elevenlabs/elevenlabs-js": "*",
    "assemblyai": "*"
  },
