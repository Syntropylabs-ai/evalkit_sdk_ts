    },
    "assemblyai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.98.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "bin": {
    "evalkit": "bin/evalkit.js"
  }
}
