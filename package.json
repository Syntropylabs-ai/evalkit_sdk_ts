{
  "name": "syntropylabs-evalkit",
  "version": "0.2.9",
  "description": "EvalKit TypeScript SDK — OpenTelemetry-based LLM observability and tracing",
  "license": "LicenseRef-Proprietary",
  "author": "Syntropy Labs",
  "homepage": "https://syntropylabs.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntropylabs-ai/evalkit_sdk_ts.git"
  },
  "bugs": {
    "url": "https://github.com/Syntropylabs-ai/evalkit_sdk_ts/issues"
  },
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "evaluation",
    "opentelemetry",
    "otel",
    "openai",
    "anthropic",
    "ai",
    "agents"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --minify --treeshake --no-sourcemap",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/autotrace.e2e.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "openai": ">=4.0.0",
    "@aws-sdk/client-bedrock-runtime": "*",
    "cohere-ai": "*",
    "@google/generative-ai": "*",
    "@google/genai": "*",
    "@google-cloud/vertexai": "*",
    "@langchain/core": "*",
    "groq-sdk": "*",
    "pg": "*",
    "mysql2": "*",
    "mongoose": "*",
    "ioredis": "*",
    "ollama": "*",
    "@pinecone-database/pinecone": "*",
    "@qdrant/js-client-rest": "*",
    "chromadb": "*",
    "weaviate-client": "*",
    "llamaindex": "*",
    "@elevenlabs/elevenlabs-js": "*",
    "assemblyai": "*"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@google-cloud/vertexai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "groq-sdk": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "ollama": {
      "optional": true
    },
    "@pinecone-database/pinecone": {
      "optional": true
    },
    "@qdrant/js-client-rest": {
      "optional": true
    },
    "chromadb": {
      "optional": true
    },
    "weaviate-client": {
      "optional": true
    },
    "llamaindex": {
      "optional": true
    },
    "@elevenlabs/elevenlabs-js": {
      "optional": true
    },
    "assemblyai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.98.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
